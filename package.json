{
    "name": "el-bridge-v2",
    "version": "1.0.0",
    "main": "dist/electron/main.js",
    "scripts": {
        "ng": "ng",
        "start": "electron-forge start",
        "serve": "concurrently \"ng serve\" \"npm run electron:watch\"",
        "electron:compile": "tsc -p electron/tsconfig.electron.json",
        "electron:watch": "tsc -p electron/tsconfig.electron.json --watch & wait-on http://localhost:4200 && electron . --remote-debugging-port=9223",
        "build": "ng build --configuration production && npm run electron:compile",
        "electron": "electron .",
        "package": "electron-forge package",
        "make": "electron-forge make",
        "package:linux-arm": "electron-forge package --platform=linux --arch=arm64",
        "make:linux-arm": "electron-forge make --platform=linux --arch=arm64"
    },
    "private": true,
    "packageManager": "npm@12.2.0",
    "dependencies": {
        "@angular/animations": "^22.1.1",
        "@angular/cdk": "^22.1.2",
        "@angular/common": "^22.1.0",
        "@angular/compiler": "^22.1.0",
        "@angular/core": "^22.1.0",
        "@angular/forms": "^22.1.0",
        "@angular/platform-browser": "^22.1.0",
        "@angular/router": "^22.1.0",
        "@types/w3c-web-usb": "^1.0.14",
        "chart.js": "^4.6.1",
        "electron-squirrel-startup": "^1.0.1",
        "electron-store": "^12.0.0",
        "rxjs": "~7.8.0",
        "tslib": "^2.3.0"
    },
    "devDependencies": {
        "@angular/build": "^22.1.3",
        "@angular/cli": "^22.1.3",
        "@angular/compiler-cli": "^22.1.0",
        "@electron-forge/cli": "^7.11.2",
        "@electron-forge/maker-deb": "^7.11.2",
        "@electron-forge/maker-rpm": "^7.11.2",
        "@electron-forge/maker-squirrel": "^7.11.2",
        "@electron-forge/maker-zip": "^7.11.2",
        "@electron-forge/plugin-auto-unpack-natives": "^7.11.2",
        "@electron-forge/plugin-fuses": "^7.11.2",
        "@electron/fuses": "^1.8.0",
        "@types/node": "^26.2.0",
        "concurrently": "^10.0.4",
        "electron": "^43.4.0",
        "jsdom": "^28.0.0",
        "prettier": "^3.8.1",
        "typescript": "~6.0.2",
        "vitest": "^4.0.8",
        "wait-on": "^9.1.0"
    }
}

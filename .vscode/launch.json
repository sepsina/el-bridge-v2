
{
    "version": "0.2.0",
    "configurations": [
        {
            "type": "node",
            "request": "attach",
            "name": "Electron: Main",
            "port": 9223,
            "sourceMaps": true,
            "outFiles": [
                "${workspaceFolder}/dist/electron/**/*.js"
            ]
        },
        {
            "name": "Electron: Renderer",
            "type": "chrome",
            "request": "attach",
            "port": 9223,
            "urlFilter": "http://localhost:4200*",
            "webRoot": "${workspaceFolder}",
            "timeout": 45000,
            /*
            "sourceMapPathOverrides": {
                "vite://devices/browser/src/*": "${workspaceFolder}/src/*",
                "vite://devices/browser/*": "${workspaceFolder}/*",
                "/*": "${workspaceFolder}/*"
            }
            */
        }
    ],
    "compounds": [
        {
            "name": "Electron: All",
            "configurations": [
                "Electron: Main",
                "Electron: Renderer"
            ]
        }
    ]
}


